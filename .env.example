# Django Configuration
# Production requirement: minimum 50 characters, high entropy, no django-insecure- prefix
SECRET_KEY=prod-sec-key-7x9v2m4q8p1z6w0y3b5t8c2d4e7f9a1h5k9j2l8m3n7_enterprise_2026
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,.onrender.com

# Database Configuration (Render sets DATABASE_URL automatically)
# In production on Render:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# In local development fallback:
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# Timezone & Localization
TIME_ZONE=Asia/Kolkata
USE_TZ=True

# Static & Security (Auto-configured on Render)
# RENDER=true
# RENDER_EXTERNAL_HOSTNAME=ai-powered-task-manager.onrender.com
# CSRF_TRUSTED_ORIGINS=https://ai-powered-task-manager.onrender.com

# Celery & Redis
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_ALWAYS_EAGER=False

# Optional: Initial Data Seeding on First Deploy
SEED_DEV_DATA=true

# Security & Admin Customization
DJANGO_ADMIN_URL=secure-admin/

# Email Configuration (Console for dev/logs, SMTP for production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@myhabittracker.com
